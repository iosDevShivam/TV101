<?xml version="1.0" encoding="utf-8"?>
<!-- The phone remote's pairing code, shown over whatever is on screen (RemoteService). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/remote_code_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingTop="16dp"
    android:paddingEnd="26dp"
    android:paddingBottom="16dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_cast"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phone_remote_pair"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_regular" />

        <TextView
            android:id="@+id/remoteCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:letterSpacing="0.12"
            android:fontFamily="@string/font_bold" />
    </LinearLayout>
</LinearLayout>
